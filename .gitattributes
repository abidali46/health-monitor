# Enforce LF line endings for all text files to ensure Linux portability
* text=auto eol=lf

# Explicit LF enforcement for scripts, configurations, and code
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.md text eol=lf
.env.example text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
