# ==============================================================================
# System Health Monitor - Environment Configuration Example
# ==============================================================================
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# DO NOT commit the resulting .env file to version control.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=health_monitor
POSTGRES_USER=monitor_user
POSTGRES_PASSWORD=change_this_to_a_secure_password

# Database Port (Internal container port, default 5432)
POSTGRES_PORT=5432

# Metric Collection Interval (in seconds)
COLLECTION_INTERVAL=30

# Grafana Admin Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
